{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bahram-brand-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bahram-brand-assistant",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
